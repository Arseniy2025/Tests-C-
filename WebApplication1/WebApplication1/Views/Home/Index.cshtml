@model List<WebApplication1.Models.Product>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Магазин</title>
    <style>
            body { font-family: Arial, sans-serif; margin: 0; background: #f4f4f4; }
            header { background: #2c3e50; color: white; padding: 12px 30px;
                     display: flex; justify-content: space-between; align-items: center; }
            .logo { font-size: 22px; font-weight: bold; }
            .tools { display: flex; gap: 20px; align-items: center; }
            .tools a, .tools span { color: white; text-decoration: none; }
            .cart-btn { background: #e67e22; padding: 6px 14px; border-radius: 6px; }
            .wallet { background: #27ae60; padding: 6px 12px; border-radius: 6px; }
            .products { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px,1fr));
                        gap: 20px; padding: 30px; }
            .card { background: white; padding: 20px; border-radius: 10px;
                    box-shadow: 0 2px 6px rgba(0,0,0,0.1); }
            .card h3 { margin: 0 0 10px; }
            .price { color: #e67e22; font-size: 20px; font-weight: bold; margin-bottom: 10px; }
            button { background: #3498db; color: white; border: none; padding: 8px 14px;
                     border-radius: 6px; cursor: pointer; }
            button:hover { background: #2980b9; }
            .login-link { background: #2ecc71; padding: 6px 14px; border-radius: 6px; }
    </style>
</head>
<body>

    <header>
        <div class="logo"> MyShop</div>

        @if (ViewBag.IsAuth == true)
        {
            <div class="tools">
              
                <span class="wallet"> @ViewBag.Wallet ₽</span>

               
                <a class="cart-btn" href="/Home/Cart">🛒 Корзина (@ViewBag.CartCount)</a>

                
                <div class="profile">
                    <span> @ViewBag.UserName ▾</span>
                    <div class="profile-menu" style="display:inline-block; margin-left:10px;">
                        <a href="/Home/Cart">Мои заказы</a> |
                        <a href="/Home/Logout">Выйти</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <a class="login-link" href="/Home/Login">Войти</a>
        }
    </header>

    <div class="products">
        @foreach (var p in Model)
        {
            <div class="card">
                <h3>@p.Name</h3>
                <div class="price">@p.Price ₽</div>
                <form method="post" action="/Home/AddToCart">
                    <input type="hidden" name="productId" value="@p.Id" />
                    <button type="submit">В корзину</button>
                </form>
            </div>
        }
    </div>

</body>
</html>

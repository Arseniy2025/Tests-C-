@model List<string>
@{
    ViewData["Title"] = "Отфильтрованный список";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h2 class="h5 mb-0">
                    <i class="bi bi-funnel"></i> Список строк после обработки
                </h2>
            </div>
            <div class="card-body">
                @if (Model == null || Model.Count == 0)
                {
                    <div class="alert alert-info d-flex align-items-center" role="alert">
                        <i class="bi bi-info-circle me-2"></i>
                        Нет данных для отображения.
                    </div>
                }
                else
                {
                    <p class="text-muted">
                        Всего записей: <span class="badge bg-secondary">@Model.Count</span>
                    </p>
                    <ul class="list-group">
                        @foreach (var line in Model)
                        {
                            <li class="list-group-item d-flex align-items-center">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                @line
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="card-footer text-muted small">
                Данные отфильтрованы и отформатированы автоматически
            </div>
        </div>

        <div class="mt-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-arrow-clockwise"></i> Обновить
            </a>
            <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-secondary">
                Конфиденциальность
            </a>
        </div>
    </div>
</div>
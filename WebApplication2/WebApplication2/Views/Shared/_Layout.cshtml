<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] — Интернет магазин</title>
    <style>
            body { font-family: system-ui, sans-serif; margin: 0; background: #f6f7fb; }
            header { display: flex; justify-content: space-between; padding: 12px 24px;
                     background: #1f2937; color: #fff; }
            .filters { padding: 16px 24px; display: flex; gap: 12px; align-items: center; }
            .filters input { width: 90px; padding: 4px 6px; }
            .filters button { padding: 6px 12px; cursor: pointer; }
            .grid { display: grid; gap: 16px; padding: 0 24px 24px;
                    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
            .card { background: #fff; border-radius: 8px; padding: 16px;
                    box-shadow: 0 1px 4px rgba(0,0,0,.08); overflow: hidden; }
            .card-img { width: 100%; height: 160px; object-fit: cover;
                        border-radius: 6px; margin-bottom: 8px; background: #eee; }
            .card button { margin-top: 8px; padding: 6px 10px; cursor: pointer; }
            .cart-row { display: flex; justify-content: space-between; align-items: center;
                        padding: 8px 12px; background: #fff; border-radius: 6px;
                        margin-bottom: 6px; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
            .cart-row button { padding: 4px 10px; cursor: pointer; background: #ef4444;
                               color: #fff; border: none; border-radius: 4px; }
    </style>
</head>
<body>
    <header>
        <span>Интернет магазин</span>
        <span> <b id="cartCount">0</b> шт. | <b id="cartTotal">0.00</b> ₽</span>
    </header>

    <main>@RenderBody()</main>


    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

 
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
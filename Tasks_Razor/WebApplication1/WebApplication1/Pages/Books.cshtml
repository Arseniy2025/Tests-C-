@page
@model BooksModel
@{ ViewData["Title"] = "Книги"; }

<h1>Книги</h1>

<div class="card mb-4">
    <div class="card-header">Добавить книгу</div>
    <div class="card-body">
        <form method="post" asp-page-handler="Add" class="row g-2">
            <div class="col-md-4"><input asp-for="NewTitle" class="form-control" placeholder="Название" /></div>
            <div class="col-md-4"><input asp-for="NewAuthor" class="form-control" placeholder="Автор" /></div>
            <div class="col-md-2"><input asp-for="NewYear" type="number" class="form-control" placeholder="Год" /></div>
            <div class="col-md-2"><button class="btn btn-primary w-100">Добавить</button></div>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <label class="form-label">Читатель для аренды:</label>
        <select id="readerSelect" class="form-select">
            @foreach (var r in Model.Readers)
            {
                <option value="@r.Id">@r.FullName</option>
            }
        </select>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr><th>Название</th><th>Автор</th><th>Год</th><th>Статус</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var b in Model.Books)
    {
        <tr>
            <td>@b.Title</td>
            <td>@b.Author</td>
            <td>@b.Year</td>
            <td>
                @if (b.IsAvailable)
                {
                    <span class="badge bg-success">Доступна</span>
                }
                else
                {
                    <span class="badge bg-danger">В аренде</span>
                }
            </td>
            <td>
                @if (b.IsAvailable)
                {
                    <form method="post" asp-page-handler="Rent" style="display:inline">
                        <input type="hidden" name="bookId" value="@b.Id" />
                        <input type="hidden" name="SelectedReaderId" id="reader_@b.Id" />
                        <button type="submit" class="btn btn-sm btn-primary"
                                onclick="document.getElementById('reader_@b.Id').value = document.getElementById('readerSelect').value;">
                            Взять в аренду
                        </button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

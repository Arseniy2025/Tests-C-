@page
@model WebApplication2.Pages.IndexModel
@{
    ViewData["Title"] = "Кликер";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
            body {
                font-family: system-ui, sans-serif;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                margin: 0;
                background: #f2f4f8;
                user-select: none;
            }

            h1 {
                margin: 0 0 20px;
            }

            .score {
                font-size: 64px;
                font-weight: 700;
                color: #2b6cb0;
                margin-bottom: 30px;
            }

            .click-btn {
                width: 220px;
                height: 220px;
                border-radius: 50%;
                border: none;
                background: radial-gradient(circle at 30% 30%, #63b3ed, #2b6cb0);
                color: #fff;
                font-size: 32px;
                font-weight: 700;
                cursor: pointer;
                box-shadow: 0 10px 25px rgba(43, 108, 176, .35);
                transition: transform .08s ease;
            }

                .click-btn:active {
                    transform: scale(.96);
                }

            .reset-btn {
                margin-top: 25px;
                padding: 10px 24px;
                border-radius: 8px;
                border: 1px solid #cbd5e0;
                background: #fff;
                cursor: pointer;
                font-size: 16px;
            }

            .error {
                color: #c53030;
                margin-top: 15px;
                font-size: 14px;
            }
    </style>
</head>
<body>
    <h1>Кликер</h1>
    <div class="score" id="score">@Model.Score</div>

    <button type="button" class="click-btn" id="clickBtn">+1</button>
    <button type="button" class="reset-btn" id="resetBtn">Сбросить</button>
    <div class="error" id="err"></div>

    @Html.AntiForgeryToken()

    <script>
            (function () {
                const scoreEl = document.getElementById('score');
                const errEl = document.getElementById('err');
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';

                console.log('Token найден:', !!tokenInput, token ? token.substring(0, 10) + '...' : '(пусто)');

                async function post(url) {
                    errEl.textContent = '';
                    try {
                        const res = await fetch(url, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            }
                        });
                        console.log('Ответ:', res.status, url);
                        if (!res.ok) {
                            errEl.textContent = 'Ошибка сервера: ' + res.status;
                            return;
                        }
                        const data = await res.json();
                        scoreEl.textContent = data.score;
                    } catch (e) {
                        console.error(e);
                        errEl.textContent = 'Ошибка сети: ' + e.message;
                    }
                }

                const clickBtn = document.getElementById('clickBtn');
                const resetBtn = document.getElementById('resetBtn');

                clickBtn.addEventListener('click', function () {
                    console.log('Клик по кнопке');
                    post('?handler=Click');
                });

                resetBtn.addEventListener('click', function () {
                    post('?handler=Reset');
                });
            })();
    </script>
</body>
</html>